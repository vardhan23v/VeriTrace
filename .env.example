# ── VeriTrace Configuration ──────────────────────────────────
# Copy to .env and fill values. Never commit .env.

# ── Visual Search (at least one recommended) ─────────────────
# SerpAPI Google Lens — https://serpapi.com/dashboard  (100 free searches)
SERPAPI_API_KEY=
# Azure Bing Visual Search — https://portal.azure.com
BING_API_KEY=
# Fallback automatically uses Bing HTML scrape (no key required)
SEARCH_PROVIDER=auto          # auto | serpapi | bing | bing_scrape
SEARCH_MAX_RESULTS=10

# ── Face Matching ────────────────────────────────────────────
FACE_SIMILARITY_THRESHOLD=0.60
FACE_DETECTION_SIZE=640
FACE_MODEL=buffalo_l          # InsightFace model pack

# ── Blockchain ───────────────────────────────────────────────
# Local chain (default) uses eth-tester in-memory — no RPC needed.
# To use Ganache / Anvil / Hardhat, set RPC_URL and PRIVATE_KEY:
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=
CONTRACT_ADDRESS=
CHAIN_ID=31337

# ── Pipeline ─────────────────────────────────────────────────
DATA_DIR=./data
LOG_LEVEL=INFO
