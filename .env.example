# ── Search ──────────────────────────────────────────────────────────
# auto | serpapi | bing | yandex | bing_scrape
#   auto  → serpapi (if key) → bing (if key) → yandex (keyless reverse-image search)
SEARCH_PROVIDER=auto
SERPAPI_API_KEY=              # https://serpapi.com/dashboard  (Google Lens, 100 free/month)
BING_API_KEY=                 # https://portal.azure.com       (Bing Visual Search, optional)
SEARCH_MAX_RESULTS=10
# Optional: a public URL of the SAME image you pass with --image. Lets URL-based providers
# (yandex / serpapi) skip the upload step. Also settable per run with --image-url.
INPUT_IMAGE_URL=
# Results whose domain contains any of these substrings are skipped (comma-separated).
SEARCH_DOMAIN_BLOCKLIST=porn,xxx,sex,nude,naked,adult,escort
# Evaluate social-media / wiki hosts first and prefer them on similarity ties.
PREFER_SOCIAL=true
# Ranking bonus for social-media candidates that already pass the face threshold (0 to disable).
SOCIAL_BONUS=0.05

# ── Face ────────────────────────────────────────────────────────────
FACE_SIMILARITY_THRESHOLD=0.45  # ArcFace cosine; 0.45 is a good "same person" cut-off for web photos
FACE_DETECTION_SIZE=640
FACE_MODEL=buffalo_l

# ── Blockchain ──────────────────────────────────────────────────────
# Leave RPC_URL empty for the zero-setup in-memory chain (eth-tester, state lost on exit).
# For persistent verification run:  npx ganache --port 8545 --chain.chainId 31337
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=                  # empty → node-managed account[0] (Ganache/Anvil/eth-tester)
CONTRACT_ADDRESS=             # optional; `python main.py deploy` caches the address in data/blockchain.json
CHAIN_ID=31337

# ── Misc ────────────────────────────────────────────────────────────
DATA_DIR=./data
LOG_LEVEL=INFO
